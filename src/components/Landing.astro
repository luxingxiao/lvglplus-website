---
import Base from '../layouts/Base.astro';import Icon from './Icon.astro';import {base,docLink,home,tr,repo,quickstart,type Lang} from '../content/site';
const {lang='zh'}=Astro.props as {lang:Lang};const t=(zh:string,en:string)=>tr(lang,zh,en);
const features=[
 ['code','XML，为人和 AI 而写。','XML. For humans and AI.','声明式页面、可复用组件与类型化绑定，让每次修改都清晰、可审查、可版本管理。','Declarative pages, reusable components, and typed bindings. Every change stays readable, reviewable, and versionable.'],
 ['layers','一套模型，贯穿整个流程。','One model, end to end.','MVVM 将协议、业务状态和界面分开。派生值、命令与数据质量由共享 C 核心处理。','MVVM separates protocols, business state, and views. A shared C core handles derived values, commands, and data quality.'],
 ['chip','预览，就用真正的引擎。','Preview the real engine.','浏览器中的 WASM 与设备端共用 LVGL 和 C 运行时。预览和生产代码遵循相同语义。','Browser WASM and device builds share LVGL and the C runtime. Preview and production follow the same semantics.'],
 ['branch','真实数据，随时接入。','Bring your own data.','从模拟、录制回放到 CAN/FD、DBC 和协议插件，替换数据源，无需重写页面。','Move from simulation and replay to CAN/FD, DBC, and protocol adapters. Change the source without rewriting the view.'],
 ['bolt','从原型，走到生产。','Prototype to production.','生成 C、资源与 CMake 工程。生产应用只依赖小型 SDK 与 LVGL，开发工具留在开发环境。','Generate C, resources, and CMake integration. Production needs the small SDK and LVGL; development tools stay on your desk.'],
 ['book','完整工具链，开放构建。','Your workflow. Open by design.','本地 Studio、CLI、静态 Viewer 和 MCP，支持设计、调试、评审与 AI 自动化。Apache 2.0 开源。','Local Studio, CLI, static Viewer, and MCP support design, debugging, review, and AI automation. Open under Apache 2.0.'],
];
const sources=['SIMULATION','REPLAY','CAN / FD','MQTT','MODBUS'];
---
<Base lang={lang} title={t('LVGL Plus — 从 XML 到每一块屏幕','LVGL Plus — From XML to every screen')} description={t('面向 AI Coding 的开源仪表开发平台。XML、MVVM、真实 LVGL/WASM 预览与生产 C，让一套模型贯通原型、数据接入和设备。','The open-source instrument UI platform for AI coding. XML, MVVM, real LVGL/WASM previews, and production C. One model, from simulation to device.')}>
<main id="main">
<section class="hero container"><a class="release-pill" href={repo+'/blob/main/CHANGELOG.md'}><span class="status-dot"></span> {t('开源，从第一行开始','OPEN SOURCE FROM THE FIRST LINE')} <span class="pill-divider"></span> v0.2.0 <Icon name="right" size={14}/></a><h1>{t('从一段 XML，','One model.')}<br/><span class="accent">{t('到每一块屏幕。','Every screen.')}</span></h1><p class="hero-description">{t('面向 AI Coding 的开源仪表开发平台。','The open-source UI platform for AI-native instrument development.')}<br class="desktop-break"/>{t('一套模型，贯通界面原型、真实数据与生产代码。','One model, from the first prototype to real data and production C.')}</p><div class="hero-actions"><a class="button primary" href={docLink(lang,'quickstart')}>{t('开始构建','Start building')}<Icon name="right" size={18}/></a><a class="button secondary" href="#playground"><Icon name="play" size={15}/>{t('体验真实 LVGL','Try real LVGL')}</a></div><div class="hero-footnote"><span><Icon name="check" size={14}/> Apache 2.0</span><span><Icon name="check" size={14}/> {t('本地优先','Local first')}</span><span><Icon name="check" size={14}/> {t('无云端依赖','No cloud required')}</span></div></section>
<section id="playground" class="product-section container" aria-labelledby="playground-title"><h2 id="playground-title" class="sr-only">{t('真实 LVGL 在线体验','Live LVGL playground')}</h2><div class="product-window"><div class="window-bar"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>vehicle / dashboard.xml</span><span class="window-engine"><span class="status-dot"></span> LVGL 9.5 · WebAssembly</span></div><div class="product-body"><aside class="code-preview" aria-label={t('XML 页面示例片段','XML page excerpt')}><div class="code-tab"><Icon name="code" size={15}/> dashboard.xml <span>XML</span></div><div class="code-lines" aria-hidden="true">01<br/>02<br/>03<br/>04<br/>05<br/>06<br/>07<br/>08<br/>09<br/>10<br/>11<br/>12<br/>13<br/>14<br/>15<br/>16<br/>17<br/>18</div><pre><code><span class="muted">&lt;!-- {t('一次描述，处处运行','Describe once. Render everywhere.')} --&gt;</span>
<span class="syntax-blue">&lt;dashboard</span> <span class="syntax-mint">version</span>=<span class="syntax-amber">"1"</span><span class="syntax-blue">&gt;</span>
  <span class="syntax-blue">&lt;page</span> <span class="syntax-mint">id</span>=<span class="syntax-amber">"home"</span><span class="syntax-blue">&gt;</span>
    <span class="syntax-blue">&lt;text</span> <span class="syntax-mint">id</span>=<span class="syntax-amber">"speed"</span>
          <span class="syntax-mint">fontSize</span>=<span class="syntax-amber">"48"</span><span class="syntax-blue">&gt;</span>
      <span class="syntax-blue">&lt;bind</span> <span class="syntax-mint">property</span>=<span class="syntax-amber">"text"</span>
            <span class="syntax-mint">signal</span>=<span class="syntax-amber">"vehicle.speed"</span>
            <span class="syntax-mint">format</span>=<span class="syntax-amber">"%.0f"</span><span class="syntax-blue">/&gt;</span>
    <span class="syntax-blue">&lt;/text&gt;</span>

    <span class="syntax-blue">&lt;arc</span> <span class="syntax-mint">id</span>=<span class="syntax-amber">"gauge"</span>
         <span class="syntax-mint">max</span>=<span class="syntax-amber">"160"</span><span class="syntax-blue">&gt;</span>
      <span class="syntax-blue">&lt;bind</span> <span class="syntax-mint">property</span>=<span class="syntax-amber">"value"</span>
            <span class="syntax-mint">signal</span>=<span class="syntax-amber">"vehicle.speed"</span><span class="syntax-blue">/&gt;</span>
    <span class="syntax-blue">&lt;/arc&gt;</span>
  <span class="syntax-blue">&lt;/page&gt;</span>
<span class="syntax-blue">&lt;/dashboard&gt;</span></code></pre><div class="code-footer"><span class="status-dot"></span>{t('声明式 · 类型安全 · Git 友好','Declarative · Typed · Git-friendly')}</div></aside><div class="instrument-preview" data-demo data-base={base} data-lang={lang}><div class="preview-topline"><span>VEHICLE INSTRUMENT</span><span>800 × 480</span></div><div class="instrument-screen"><img class="instrument-fallback" src={base+'images/instrument.png'} alt={t('真实 LVGL 渲染的车辆仪表，显示车速、电量、温度与续航','A native LVGL-rendered vehicle instrument with speed, battery, temperature, and range')} width="800" height="480" fetchpriority="high"/><canvas class="demo-canvas" width="800" height="480" aria-label={t('可交互的真实 LVGL 仪表','Interactive real LVGL instrument')} hidden></canvas><div class="demo-load-cover"><button class="load-demo button primary"><Icon name="play" size={16}/>{t('启动交互演示','Launch live demo')}</button><span>{t('真实 C/WASM · 不连接任何设备','Real C/WASM · No device connected')}</span></div></div><div class="demo-controls"><div class="demo-source"><label for="demo-mode">{t('数据源','SOURCE')}</label><select id="demo-mode" disabled><option value="simulation">{t('模拟数据','Simulation')}</option><option value="replay">{t('驾驶回放','Drive replay')}</option><option value="manual">{t('手动注入','Manual input')}</option></select><button class="demo-pause small-button" disabled aria-pressed="true">{t('暂停','Pause')}</button></div><div class="demo-sliders"><label for="demo-speed">{t('车速','Speed')}<output id="demo-speed-output">0</output><span>km/h</span><input id="demo-speed" type="range" min="0" max="160" value="0" disabled/></label><label for="demo-soc">{t('电量','Battery')}<output id="demo-soc-output">82</output><span>%</span><input id="demo-soc" type="range" min="0" max="100" value="82" disabled/></label></div><div class="demo-status-row"><span class="demo-status" role="status">{t('按需加载；静态画面同样来自 LVGL','Loads on demand. Static image also rendered by LVGL.')}</span><button class="demo-offline small-button" disabled aria-pressed="false">{t('模拟断线','Go offline')}</button></div></div></div></div><div class="window-status"><span><Icon name="check" size={12}/> {t('同一 C 核心，驱动预览与生产','One C core for preview and production')}</span><a href={repo+'/tree/main/examples/vehicle'}>{t('查看完整示例','View full example')}<Icon name="arrow" size={12}/></a></div></div><p class="product-caption">{t('这不是 HTML 仿制仪表。每一个像素，都由 LVGL 绘制。','Every pixel comes from LVGL. The same rendering engine that runs on your device.')}</p></section>
<section class="principles container" aria-label={t('核心技术','Core technology')}>{[['XML FIRST',t('让意图成为代码','Intent becomes code')],['SHARED C CORE',t('让预览接近真实','Preview meets reality')],['PRODUCTION READY PATH',t('让原型走向设备','Prototype becomes product')]].map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</section>
<section class="energy-teaser container" aria-labelledby="energy-teaser-title"><a href={home(lang)+'examples/energy-console/'} class="energy-teaser-image"><img src={base+'demo/energy/poster.png'} width="1024" height="600" loading="lazy" alt={t('能源控制台：环形负载表、涡轮与动态曲线','Energy console with an annular gauge, turbine and dynamic curves')}/></a><div><span class="eyebrow">NEW / INTERACTIVE EXAMPLE</span><h2 id="energy-teaser-title">{t('不止一个仪表。','A more complex instrument.')}<br/>{t('体验能源控制台。','Explore the energy console.')}</h2><p>{t('平滑渐变、旋转分层、动态曲线和负载告警。仅用 XML 与 Model，组合成真实 LVGL 界面。','Smooth gradients, rotating layers, dynamic curves and load warnings. Compose a real LVGL interface with XML and Model.')}</p><a class="button secondary" href={home(lang)+'examples/energy-console/'}>{t('打开交互示例','Open live example')}<Icon name="right" size={16}/></a></div></section>
<section id="platform" class="workflow-section section container"><div class="section-heading"><div><span class="eyebrow">01 / THE WORKFLOW</span><h2>{t('界面不变。','Keep the view.')}<br/>{t('数据，自由流动。','Change the source.')}</h2></div><p>{t('先在电脑上完成界面设计与调试，再接入真实设备。协议、业务与视图清晰分层，让每一步都能独立推进。','Design and debug your instrument on your computer. Connect the hardware when you are ready. Protocols, business logic, and views evolve independently.')}</p></div><div class="flow-panel"><div class="flow-sources">{sources.map((s,i)=><span><i>{String(i+1).padStart(2,'0')}</i>{s}</span>)}</div><div class="flow-track"><div><small>INPUT</small><strong>Transport</strong><span>Codec + Mapping</span></div><Icon name="right"/><div class="flow-model"><small>SHARED C CORE</small><strong>Model <span>+ ViewModel</span></strong><span>{t('类型 · 派生值 · 命令 · 数据质量','Types · Derived values · Commands · Quality')}</span></div><Icon name="right"/><div><small>OUTPUT</small><strong>LVGL</strong><span>{t('浏览器 / 桌面 / 设备','Browser / Desktop / Device')}</span></div></div><div class="flow-footer"><code>XML → IR → WASM / C</code><a href={docLink(lang,'architecture')}>{t('探索技术架构','Explore the architecture')}<Icon name="right" size={15}/></a></div></div></section>
<section class="features-section section container"><div class="section-heading"><div><span class="eyebrow">02 / BUILT FOR BUILDERS</span><h2>{t('更少的边界，','Less friction.')}<br/>{t('更多的可能。','More possibility.')}</h2></div><p>{t('为仪表开发而设计，也为新的开发方式而生。把精力放在产品体验，把重复的工作交给工具。','Purpose-built for instruments. Designed for a new way to develop. Focus on the experience, while the toolchain handles the repetition.')}</p></div><div class="feature-grid">{features.map(([icon,zhTitle,enTitle,zhBody,enBody],i)=><article class="feature"><div class="feature-top"><Icon name={icon} size={23}/><span>{String(i+1).padStart(2,'0')}</span></div><h3>{t(zhTitle,enTitle)}</h3><p>{t(zhBody,enBody)}</p></article>)}</div></section>
<section id="start" class="quickstart-section section container"><div class="quickstart-copy"><span class="eyebrow">03 / YOUR FIRST SCREEN</span><h2>{t('下一块屏幕，','Your next screen')}<br/>{t('从这里开始。','starts here.')}</h2><p>{t('克隆源码，启动本地 Studio。无需账号，也无需先接上一块开发板。','Clone the source and launch your local Studio. No account, no board, no cloud in the loop.')}</p><a class="text-link" href={docLink(lang,'quickstart')}>{t('阅读完整安装指南','Read the setup guide')}<Icon name="right" size={17}/></a><div class="requirements"><span>Node.js 24+</span><span>pnpm 11.7</span><span>Python 3</span><span>CMake</span></div></div><div class="terminal"><div class="terminal-header"><span><Icon name="terminal" size={16}/> {t('从源码开始','Start from source')}</span><button class="icon-button" aria-label={t('复制快速开始命令','Copy quickstart commands')} data-copy={quickstart}><Icon name="copy" size={16}/></button></div><pre><code><span class="muted"># {t('安装项目本地构建依赖','Install project-local build dependencies')}</span>
{quickstart.split('\n').map(line=><><span class="prompt">$ </span>{line}<br/></>)}</code></pre><div class="terminal-foot"><span class="status-dot"></span>{t('在浏览器打开','Open in your browser')} <code>localhost:5178</code></div></div></section>
<section class="compat-section section container"><div class="section-heading"><div><span class="eyebrow">04 / BUILT TO TRAVEL</span><h2>{t('跨平台的底座。','Portable by design.')}<br/>{t('可验证的承诺。','Verified in the open.')}</h2></div><p>{t('以 LVGL 的跨平台能力为基础，用实际验证逐步扩大设备范围。每一个支持状态，都有清晰的依据。','Built on LVGL’s portable foundation. Platform support grows through real verification, with a clear distinction between implemented and tested.')}</p></div><div class="platform-grid"><article><span class="platform-name">WebAssembly</span><span class="platform-state verified"><Icon name="check" size={14}/>{t('真实引擎已验证','Real engine verified')}</span><p>{t('与原生和生成 C 精确像素一致。','Exact pixel parity with native and generated C.')}</p></article><article><span class="platform-name">Linux / macOS</span><span class="platform-state verified"><Icon name="check" size={14}/>{t('已有软件验证','Software checks available')}</span><p>{t('桌面工具链；Linux vcan/FD 已有测试记录。','Desktop tooling and recorded Linux vcan/FD tests.')}</p></article><article><span class="platform-name">Cortex-M4</span><span class="platform-state pending">{t('交叉编译','Cross-compiled')}</span><p>{t('完整 UI 栈静态库通过；板卡由 BSP 适配。','UI stack static libraries compile. Board integration needs a BSP.')}</p></article><article><span class="platform-name">Windows / Hardware</span><span class="platform-state pending">{t('待验收','Verification pending')}</span><p>{t('Windows、真实 MCU 与 DRM 显示单独验收。','Windows, physical MCUs, and DRM displays need separate acceptance.')}</p></article></div><a class="text-link" href={docLink(lang,'compatibility')}>{t('查看完整验证与限制','Read verification details & limits')}<Icon name="right" size={16}/></a></section>
<section class="final-cta container"><div class="cta-mark" aria-hidden="true">L<span>+</span></div><span class="eyebrow">OPEN SOURCE. OPEN POSSIBILITIES.</span><h2>{t('把想法，','Bring your ideas')}<br/>{t('带到每一块屏幕。','to every screen.')}</h2><p>{t('为下一代仪表，构建下一代开发方式。','A new way to build the next generation of instruments.')}</p><div class="hero-actions"><a class="button primary" href={docLink(lang,'quickstart')}>{t('开始你的项目','Build your first project')}<Icon name="right" size={17}/></a><a class="button secondary" href={repo}>{t('在 GitHub 参与构建','Build with us on GitHub')}<Icon name="arrow" size={16}/></a></div></section>
</main>
<script>import '../scripts/playground';</script>
</Base>
