---
import Base from '../layouts/Base.astro';import Icon from './Icon.astro';import {docs,docTitle,type Doc} from '../content/docs';import {home,docLink,tr,repo,type Lang} from '../content/site';
const {doc,lang='zh'}=Astro.props as {doc:Doc;lang:Lang};const n=lang==='zh'?0:1;const headings=[...doc.body[n].matchAll(/<h2 id="([^"]+)">([^<]+)<\/h2>/g)];
---
<Base title={doc.title[n]+' — LVGL Plus'} description={doc.intro[n]} lang={lang} slug={doc.slug}><main id="main" class="container docs-layout"><aside class="docs-sidebar" aria-label={tr(lang,'文档导航','Documentation navigation')}><span class="eyebrow">LVGL PLUS / DOCS</span>{docs.map(d=><a href={docLink(lang,d.slug)} aria-current={d.slug===doc.slug?'page':undefined}>{docTitle(d,lang)}</a>)}<a class="source-link" href={repo+'/blob/main/'+doc.source}>{tr(lang,'源码中的完整文档','Full source documentation')} <Icon name="arrow" size={13}/></a></aside><article class="doc-article"><div class="doc-breadcrumb"><a href={home(lang)}>LVGL Plus</a><span>/</span><span>{tr(lang,'文档','Docs')}</span><span>/</span><span>{doc.title[n]}</span></div><h1>{doc.title[n]}</h1><p class="doc-lead">{doc.intro[n]}</p><nav class="doc-toc" aria-label={tr(lang,'本页目录','On this page')}>{headings.map(h=><a href={'#'+h[1]}>{h[2]}</a>)}</nav><div class="doc-body" set:html={doc.body[n]}/><div class="doc-end"><a href={repo+'/blob/main/'+doc.source}>{tr(lang,'查看 / 改进源码文档','Read / improve the source docs')} <Icon name="arrow" size={13}/></a><span>{tr(lang,'对齐源码版本','Source version')} 0.2.0 · LVGL 9.5.0</span></div></article></main></Base>
