---
import '../styles/global.css';import '@fontsource-variable/space-grotesk';import '@fontsource-variable/inter';
import Icon from '../components/Icon.astro';import {base,home,docLink,tr,repo,webRepo,type Lang} from '../content/site';
interface Props{title:string;description?:string;lang?:Lang;slug?:string;}
const {title,description= 'LVGL Plus：面向 AI Coding 的开源仪表 UI 平台。从 XML、真实 LVGL 预览到生产 C，一套模型贯通模拟、回放与真实数据。',lang='zh',slug=''}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://luxingxiao.github.io').href;
const other=lang==='zh'?'en':'zh';
const alternate=slug?docLink(other,slug):home(other);
---
<!doctype html><html lang={lang==='zh'?'zh-CN':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#090d12"/><link rel="icon" type="image/svg+xml" href={base+'favicon.svg'}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={other==='zh'?'zh-CN':'en'} href={'https://luxingxiao.github.io'+alternate}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={'https://luxingxiao.github.io'+base+'images/social.svg'}/><meta name="twitter:card" content="summary_large_image"/><meta name="color-scheme" content="dark"/></head><body>
<a href="#main" class="skip-link">{tr(lang,'跳到主要内容','Skip to content')}</a>
<header class="site-header"><div class="container nav-wrap"><a class="brand" href={home(lang)} aria-label="LVGL Plus home"><span class="brand-symbol" aria-hidden="true">L<span>+</span></span><span>LVGL<span class="brand-plus">PLUS</span></span></a><button class="mobile-menu icon-button" aria-label={tr(lang,'展开导航','Open navigation')} aria-expanded="false" aria-controls="primary-nav"><Icon name="menu"/></button><nav id="primary-nav" aria-label={tr(lang,'主导航','Main navigation')}><a href={home(lang)+'#platform'}>{tr(lang,'平台','Platform')}</a><a href={home(lang)+'#playground'}>{tr(lang,'在线体验','Playground')}</a><a href={docLink(lang,'quickstart')} aria-current={slug==='quickstart'?'page':undefined}>{tr(lang,'文档','Docs')}</a><a href={docLink(lang,'roadmap')} aria-current={slug==='roadmap'?'page':undefined}>{tr(lang,'路线图','Roadmap')}</a></nav><div class="nav-end"><a class="language-switch" href={alternate} lang={other==='zh'?'zh-CN':'en'}><Icon name="globe" size={16}/>{lang==='zh'?'EN':'中文'}</a><a class="github-link" href={repo}><Icon name="github" size={18}/><span>GitHub</span><Icon name="arrow" size={14}/></a></div></div></header>
<slot/>
<footer class="site-footer"><div class="container"><div class="footer-main"><div><a class="brand" href={home(lang)}><span class="brand-symbol" aria-hidden="true">L<span>+</span></span><span>LVGL<span class="brand-plus">PLUS</span></span></a><p>{tr(lang,'从一段 XML，到每一块屏幕。','From a line of XML to every screen.')}</p></div><div class="footer-links"><div><span>{tr(lang,'开始构建','Build')}</span><a href={docLink(lang,'quickstart')}>{tr(lang,'快速开始','Quickstart')}</a><a href={docLink(lang,'architecture')}>{tr(lang,'技术架构','Architecture')}</a><a href={docLink(lang,'data')}>{tr(lang,'数据接入','Data integration')}</a></div><div><span>{tr(lang,'开源项目','Open source')}</span><a href={repo}>{tr(lang,'源码仓库','Source code')}</a><a href={repo+'/issues'}>{tr(lang,'问题与建议','Issues & ideas')}</a><a href={repo+'/blob/main/CONTRIBUTING.md'}>{tr(lang,'参与贡献','Contribute')}</a></div><div><span>{tr(lang,'了解更多','Explore')}</span><a href={docLink(lang,'compatibility')}>{tr(lang,'兼容性与验证','Compatibility')}</a><a href={docLink(lang,'roadmap')}>{tr(lang,'开发路线图','Roadmap')}</a><a href={webRepo}>{tr(lang,'改进这个网站','Improve this site')}</a></div></div></div><div class="footer-bottom"><span>© 2026 LVGL Plus contributors · Apache 2.0</span><span>{tr(lang,'独立开源项目 · 基于 LVGL 9.5','Independent open source · Built on LVGL 9.5')}</span></div></div></footer>
<div class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
<script>import '../scripts/site';</script>
</body></html>
